{
  "id": "dev.botawesome.velounizer",
  "name": "Velounizer",
  "description": {
    "de": "Tinte, Aurora und Kontur: Bilder, die deiner Musik folgen",
    "en": "Ink, Aurora and Contour: visuals that follow your music"
  },
  "version": "0.1.0",
  "kind": "visualizer",
  "api": 1,
  "velouna": ">=0.2.1",
  "author": "BotAwesome",
  "license": "GPL-3.0-or-later",
  "permissions": [],
  "visualizer": {
    "needs": "song",
    "presets": [
      {
        "id": "ink",
        "name": {
          "de": "Tinte",
          "en": "Ink"
        },
        "score": "ink/score.lua",
        "passes": [
          {
            "id": "sim",
            "shader": "ink/sim.glsl",
            "scale": 0.5,
            "format": "rgba16f",
            "feedback": true,
            "rate": "step"
          },
          {
            "id": "scene",
            "shader": "ink/draw.glsl",
            "inputs": [
              "sim"
            ]
          }
        ],
        "params": [
          {
            "id": "size",
            "label": {
              "de": "Tropfengröße",
              "en": "Drop size"
            },
            "min": 0.3,
            "max": 2.5,
            "default": 1.0
          },
          {
            "id": "life",
            "label": {
              "de": "Lebensdauer (s)",
